{
  "name": "marketplace",
  "version": "1.0.0",
  "description": "marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ok-Trygub/Marketplace"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/src/server.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "npm run build && node dist/src/server.js",
    "dev": "npm run build && node --watch dist/src/server.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:status": "docker compose ps",
    "openapi:lint": "npx @redocly/cli lint openapi/openapi.yaml",
    "openapi:bundle": "redocly bundle openapi/openapi.yaml -o spec.json",
    "check:env": "npm run build && node scripts/check-env-example.mjs",
    "secrets:seed": "infisical run --silent -- node scripts/seed-db-password.mjs",
    "migrate": "bash scripts/with-secrets.sh dev typeorm migration:run -d dist/src/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev typeorm migration:show -d dist/src/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev typeorm migration:revert -d dist/src/data-source.js",
    "migrate:generate": "bash scripts/with-secrets.sh dev typeorm migration:generate -d dist/src/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/src/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/src/demo-nplus1.js",
    "report": "bash scripts/with-secrets.sh dev node dist/src/report.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/src/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/src/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/src/demo-retry.js",
    "test:integration": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest integration",
    "test:e2e": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest e2e",
    "test:contract": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest contract/consumer",
    "verify:provider": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest contract/provider"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@redocly/cli": "^2.49.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "express": "^4.22.2",
    "express-openapi-validator": "^5.6.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4"
  }
}
