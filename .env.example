# Port the HTTP server listens on. Required.
PORT=5001

# Connection URL without a password: host, port, database and user. The host and port
# are PgBouncer, the application never connects to Postgres directly.
# The password is never read from the environment, see DB_PASSWORD_FILE. Required.
# Use `localhost` when the app runs on the host and `pgbouncer` inside Compose.
DB_URL=postgres://app_user@localhost:6432/marketplace

# Path to the file that holds the database password. Relative paths are resolved
# from the working directory. The file is re-read on every new connection, which
# is what makes password rotation without a restart possible. Default: secrets/db_password
DB_PASSWORD_FILE=secrets/db_password

# Minimum level that reaches the log: debug, info, warn or error. Default: info
LOG_LEVEL=info

# Timeout for acquiring a database connection, in milliseconds. Default: 5000
TIMEOUT_MS=5000
